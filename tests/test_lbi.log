> L <- 0:60

> n <- ifelse(L >= 10 & L < 50, 100, 0)

> u <- FLQuants(U = FLQuant(n, dimnames = list(len = L, 
+     year = 2000)))

> xu <- lbi_flicc(u, FLPar(linf = 55, L50 = 30))$values

> stopifnot(abs(xu$Lbar - 30) < 1e-09, abs(xu$L25 - 
+     20) < 1e-09, abs(xu$L95 - 48) < 1e-09, abs(xu$Lmax5 - 49) < 
+     1e-09, abs(xu$Pmat - 0.5) < 1e-09, xu$Lc == 10.5)

> fit <- fiticc(lfd, stocklen(lfd, lhpar, m_model = "constant"), 
+     sel_fun = c("dsnormal", "logistic"), catch_by_gear = c(0.95, 
+         0.05))
FLicc: the Dirichlet-multinomial precision is estimated best from raw counts or an effective sample size of at least 500 per gear and year (median here: Trawl 600, Gillnet 400).

> xf <- lbi_flicc(fit)

> stopifnot(nrow(xf$values) == nrow(v[v$gear != "pooled", 
