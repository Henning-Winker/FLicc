$obj$simulate
function (par = last.par, complete = FALSE) 
{
    f(par, order = 0, type = "double", do_simulate = TRUE)
    sim <- as.list(reportenv)
    if (complete) {
        ans <- data
        ans[names(sim)] <- sim
    }
    else {
        ans <- sim
    }
    ans
}
