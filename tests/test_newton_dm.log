function (x = last.par[lfixed()], atomic = usingAtomics()) 
{
    if (is.null(random)) {
        if (!atomic) 
            return(f(x, order = 2))
        if (is.null(ADGrad)) 
            retape_adgrad()
        return(f(x, type = "ADGrad", order = 1))
    }
    else {
        stop("Hessian not yet implemented for models with random effects.")
    }
}
