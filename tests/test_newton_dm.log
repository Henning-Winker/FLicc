$obj$fn
function (x = last.par[lfixed()], ...) 
{
    if (tracepar) {
        cat("par:\n")
        print(x)
    }
    if (!validpar(x)) 
        return(NaN)
    if (is.null(random)) {
        ans <- f(x, order = 0)
        if (!ADreport) {
            if (is.finite(ans) && ans < value.best) {
                last.par.best <<- x
                value.best <<- ans
            }
        }
    }
    else {
        ans <- try({
            if (MCcontrol$doMC) {
                ff(x, order = 0)
                MC(last.par, n = MCcontrol$n, seed = MCcontrol$seed, 
                  order = 0)
            }
            else ff(x, order = 0)
        }, silent = silent)
        if (is.character(ans)) 
            ans <- NaN
    }
    ans
}
