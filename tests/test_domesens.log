> pr <- function(f) {
+     p <- f$par[f$par$par %in% c("log_Linf", "log_Mk", "log_Galpha"), 
+         ]
+     p$value <- ifelse(p$par == "log_Galpha", 1/sqrt(exp(p$mpd)), 
+         exp(p$mpd))
+     p
+ }

