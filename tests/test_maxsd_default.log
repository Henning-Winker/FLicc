+     for (i in seq_len(n)) t[i] <- system.time(f <- fiticc(lfd, 
+         stklen, sel_fun = sf, catch_by_gear = cbg, settings = set, 
+         se = se))[["elapsed"]]
+     list(fit = f, time = median(t))
+ }

