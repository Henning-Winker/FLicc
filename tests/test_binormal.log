+     conv = c(f_ds$diagnostics$conv_tier, f_bn$diagnostics$conv_tier), 
+     AIC = c(AIC(LLflicc(f_ds)), AIC(LLflicc(f_bn))), SPR_last = c(tail(c(f_ds$report$spr), 
+         1), tail(c(f_bn$report$spr), 1)))

> print(tab)
     model conv      AIC  SPR_last
1 dsnormal   ok 79244.59 0.9295636
2 binormal   ok 79253.27 0.4245635

> p <- as.list(as.numeric(sp$Pooled))

> names(p) <- dimnames(sp$Pooled)$params

> stopifnot(p$mode2 > p$mode1, all(is.finite(unlist(p))))

> L <- as.numeric(f_bn$tmb_data$Lmid)

> s_r <- sel_curve_flicc(L, "binormal", p)

> s_t <- as.numeric(f_bn$obj$report(f_bn$obj$env$last.par.best)$Sel[, 
+     1])

> cat("max |R - TMB| selectivity:", max(abs(s_r - s_t)), 
+     "\n")
max |R - TMB| selectivity: 6.661338e-16 

> stopifnot(max(abs(s_r - s_t)) < 1e-06, abs(max(s_t) - 
+     1) < 1e-08)

> f_fx <- fiticc(lfdc, stk, sel_fun = "binormal", catch_by_gear = 1, 
+     settings = set, sel_fixed = list(Pooled = list(h = 1, sd2 = p$sd2)))

