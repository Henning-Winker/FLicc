> data("alfonsino")

> lfd <- FLQuantLen(lfd_long_to_wide(as.data.frame(lfd_alfonsino)), 
+     unit = "cm", midL = FALSE)

> lhpar <- FLPar(linf = 55.7, k = 0.08, M = 0.162, L50 = 31.1859, 
+     a = 0.004721956/1000, b = 3.146168)

> lfdc <- FLQuants(Pooled = lfd[[1]] + lfd[[2]])

> stk <- stocklen(lfdc, lhpar, m_model = "constant")

> od <- if (dir.exists("out/tests")) "out/tests" else "."

> set <- list(CVL = 0.1)

> f_ds <- fiticc(lfdc, stk, sel_fun = "dsnormal", catch_by_gear = 1, 
+     settings = set)

> f_bn <- fiticc(lfdc, stk, sel_fun = "binormal", catch_by_gear = 1, 
+     settings = set)

> print(f_bn$diagnostics)
