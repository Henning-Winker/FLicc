> add_rw <- function(td) {
+     td$prior_sigmaF_mean <- log(0.3)
+     td$prior_sigmaF_sd <- 0
+     td$prior_sigmaF_use <- 1
+     td$FM_min <- 0.05
+     td$FM_max <- 4
+     td$FMpen_sd <- 0
+     td
+ }

> obs <- as.matrix(read.csv(file.path(ddir, "obs_Rdev_1.csv"), 
+     header = FALSE))

> rp <- read.csv(file.path(ddir, "ref_par.csv"))

> th <- read.csv(file.path(ddir, "ref_sel.csv"))$theta

> ref <- as.matrix(read.csv(file.path(ddir, "ref_pred_dyng.csv"), 
+     header = FALSE))

> lens <- seq(0, 66, by = 2)

> yrs <- 2005:2024

> lfd1 <- FLQuants(G1 = FLQuant(t(obs), dimnames = list(len = lens, 
+     year = yrs)))

> k <- 0.08

> linf <- 55.662

> lhp <- FLPar(linf = linf, k = k, M = 0.162, L50 = linf * 
+     (1 - exp(-k * 6)), a = 3.24e-05, b = 2.932)

> stk1 <- stocklen(lfd1, lhp, m_model = "constant")

> set_ref <- list(CVL = 0.1, pop_model = "gtg.dyn", 
+     obs_model = "mn", ngtg = 19, maxsd = 3, dyn_npre = 10, dyn_nq = 2, 
+     dyn_db = 0.25, dyn_h = 2, dyn_Tcap = 40, dyn_rec = "iid", 
+     GL = 30)

> cbg1 <- FLQuants(G1 = quantSums(lfd1[[1]]) * 0 + 1)

> td <- add_rw(FLicc:::data_tmb_flicc(lfd1, stk1, sel_fun = "dsnormal", 
+     catch_by_gear = cbg1, settings = set_ref))

> pl <- FLicc:::init_tmb_flicc(td)

> pl$Sm <- c(log(th[1]/linf), th[2] - log(linf), th[3] - 
+     log(linf))

> pl$log_Fk[] <- rp$logF[11:30] - log(k)

> pl$log_Fpre[] <- rp$logF[1:10] - log(k)

> pl$log_Rdev <- rp$logR

> r1 <- rep_at(td, pl)

> d_ref <- max(abs(t(r1$plen[, , 1]) - ref))

> cat(sprintf("REFERENCE: max |FLicc gtg.dyn - prototype| = %.2e\n", 
+     d_ref))
REFERENCE: max |FLicc gtg.dyn - prototype| = 3.06e-12

> stopifnot(d_ref < 1e-08)

